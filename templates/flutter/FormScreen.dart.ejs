  /// Inicializa el motor de reconocimiento de voz del sistema
  Future<void> _initSpeech() async {
    try {
      _speechAvailable = await _speech.initialize(
        onError: (val) {
          debugPrint('Speech error: ${val.errorMsg}');
          if (mounted) setState(() => _isListening = false);
        },
        onStatus: (status) {
          debugPrint('Speech status: $status');
          if ((status == 'done' || status == 'notListening') && _isListening) {
            if (mounted) {
              setState(() => _isListening = false);
              if (_liveTranscription.trim().isNotEmpty) {
                _processAiVoiceFill(_liveTranscription.trim());
              }
            }
          }
        },
      );
      if (mounted) setState(() {});
    } catch (e) {
      debugPrint('Speech init error: $e');
    }
  }

  /// Alterna entre escuchar y detener la grabación
  void _toggleVoiceRecording() async {
    if (_isAiProcessing) return;

    if (_isListening) {
      await _speech.stop();
      setState(() => _isListening = false);
      if (_liveTranscription.trim().isNotEmpty) {
        _processAiVoiceFill(_liveTranscription.trim());
      }
      return;
    }

    if (!_speechAvailable) {
      final available = await _speech.initialize();
      setState(() => _speechAvailable = available);
      if (!available) {
        if (mounted) {
          ScaffoldMessenger.of(context).showSnackBar(
            const SnackBar(
              content: Text('Permiso de micrófono no concedido o reconocimiento de voz no disponible.'),
              backgroundColor: Colors.red,
            ),
          );
        }
        return;
      }
    }

    setState(() {
      _isListening = true;
      _liveTranscription = '';
    });

    _showVoiceListeningModal();

    await _speech.listen(
      onResult: (result) {
        if (mounted) {
          setState(() {
            _liveTranscription = result.recognizedWords;
          });
        }
      },
      localeId: 'es_ES',
      listenFor: const Duration(seconds: 30),
      pauseFor: const Duration(seconds: 4),
    );
  }

