            Expanded(child: Text('🧠 IA deduciendo campos faltantes y coherencias...')),
          ],
        ),
        duration: Duration(seconds: 15),
      ),
    );

    try {
      final fieldsList = [
<% editableAttrs.forEach(function(attr) { %>
<% const dartType = attr.isRelation ? mapToDartType(attr.referencedIdType || idType) : mapToDartType(attr.type); %>
<% const originalFieldName = attr.isRelation ? (attr.name + 'Id') : attr.name; %>
<% const sanitizedFieldName = sanitizeFieldName(originalFieldName); %>
        {
          'name': '<%= sanitizedFieldName %>',
          'type': '<%= dartType %>',
          'label': '<%= attr.isRelation ? attr.name + " ID" : attr.name %>',
          'required': <%= !attr.nullable %>,
        },
<% }); %>
      ];

      final filledData = await ApiService.fillFormWithVoice(
        transcription: spokenText,
        entityName: '<%= toPascalCase(className) %>',
        fields: fieldsList,
      );

      if (mounted) {
        setState(() {
<% editableAttrs.forEach(function(attr) { %>
<% const dartType = attr.isRelation ? mapToDartType(attr.referencedIdType || idType) : mapToDartType(attr.type); %>
<% const originalFieldName = attr.isRelation ? (attr.name + 'Id') : attr.name; %>
<% const sanitizedFieldName = sanitizeFieldName(originalFieldName); %>
<% if (dartType === 'bool') { %>
          if (filledData.containsKey('<%= sanitizedFieldName %>') && filledData['<%= sanitizedFieldName %>'] != null) {
            final val = filledData['<%= sanitizedFieldName %>'];
            _<%= sanitizedFieldName %> = val is bool ? val : val.toString().toLowerCase() == 'true';
          }
<% } else if (dartType === 'DateTime') { %>
          if (filledData.containsKey('<%= sanitizedFieldName %>') && filledData['<%= sanitizedFieldName %>'] != null) {
            final parsed = DateTime.tryParse(filledData['<%= sanitizedFieldName %>'].toString());
            if (parsed != null) _<%= sanitizedFieldName %> = parsed;
          }
<% } else { %>
          if (filledData.containsKey('<%= sanitizedFieldName %>') && filledData['<%= sanitizedFieldName %>'] != null) {
            _<%= sanitizedFieldName %>Controller.text = filledData['<%= sanitizedFieldName %>'].toString();
          }
<% } %>
<% }); %>
        });

        ScaffoldMessenger.of(context).hideCurrentSnackBar();
        ScaffoldMessenger.of(context).showSnackBar(
          const SnackBar(
            content: Text('✨ ¡Formulario completado con éxito por voz e IA!'),
            backgroundColor: Colors.green,
            duration: Duration(seconds: 4),
          ),
        );
      }
    } catch (e) {
      if (mounted) {
        ScaffoldMessenger.of(context).hideCurrentSnackBar();
        ScaffoldMessenger.of(context).showSnackBar(
          SnackBar(
            content: Text('Error al procesar: $e'),
            backgroundColor: Colors.red,
          ),
        );
      }
    } finally {
      if (mounted) {
        setState(() => _isAiProcessing = false);
      }
    }
  }

